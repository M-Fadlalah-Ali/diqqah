<?xml version="1.0" encoding="utf-8"?>
<!-- س227 (المرحلة صفر د6 من خارطة طريق التقرير الاستشاري): الانطلاقة
     بهوية المشروع — بني الهوية العميق (#8B5A3C) والكلمة الوسطة بحبر
     الهوية الفاتح (diqqah_splash_wordmark) بدل الأبيض الافتراضي،
     والوضع الليلي نظيره أدناه (drawable-v21). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <color android:color="#8B5A3C" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/diqqah_splash_wordmark" />
    </item>
</layer-list>
